<style>
    .signal-wrap {
        width: 100%;
        max-width: 680px;
        margin: 1.75rem 0 2.25rem 0;
        padding: 0.75rem 1rem;
        border-radius: 1rem;
        background: rgba(16, 19, 29, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
    }
    .signal-line {
        width: 100%;
        height: 64px;
        display: block;
    }
    .signal-noisy {
        animation: fade-out 2s ease-in forwards;
    }
    .signal-smooth {
        opacity: 0;
        stroke-dasharray: 900;
        stroke-dashoffset: 900;
        animation:
            fade-in 1s ease-out 0.8s forwards,
            draw 2s cubic-bezier(0.16, 1, 0.3, 1) 0.8s forwards;
    }
    @keyframes fade-out {
        0% { opacity: 0.6; }
        100% { opacity: 0.2; }
    }
    @keyframes fade-in {
        to {
            opacity: 1;
        }
    }
    @keyframes draw {
        to {
            stroke-dashoffset: 0;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .signal-noisy,
        .signal-smooth {
            animation: none;
        }
        .signal-noisy {
            opacity: 0.2;
        }
        .signal-smooth {
            opacity: 1;
            stroke-dashoffset: 0;
        }
    }
</style>

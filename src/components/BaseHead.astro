---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import { ClientRouter } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";
import FallbackImage from "../assets/og-image.jpg";
import { SITE_TITLE } from "../consts";

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<ClientRouter />
<Analytics />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Abhishek — Data & AI" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.site)} />
<meta property="og:image:secure_url" content={new URL(image.src, Astro.site)} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Abhishek — Data & AI | Turning messy data into decisions you can trust." />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta property="twitter:domain" content="abhibuildsai.com" />
<meta property="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image.src, Astro.site)} />
<meta name="twitter:image:alt" content="Abhishek — Data & AI | Turning messy data into decisions you can trust." />

<!-- Page interactions use delegated handlers so Astro page swaps do not retain stale elements. -->
<script is:inline>
	(() => {
		if (window.__siteInteractionsInitialized) return;
		window.__siteInteractionsInitialized = true;
		let lightboxTrigger = null;

		const closeLightbox = () => {
			const modal = document.getElementById('global-lightbox-modal');
			if (!modal) return;
			modal.classList.remove('active');
			document.body.style.overflow = '';
			lightboxTrigger?.focus();
		};

		const setupPageInteractions = () => {
			const canvas = document.getElementById('bg-canvas');
			const current = window.__siteCanvasState;
			if (current?.canvas !== canvas) {
				if (current) {
					cancelAnimationFrame(current.frame);
					window.removeEventListener('resize', current.resize);
				}
				delete window.__siteCanvasState;
			}
			if (canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && !window.__siteCanvasState) {
				const ctx = canvas.getContext('2d');
				if (ctx) {
					let width = 0;
					let height = 0;
					const particles = [];
					const resize = () => {
						const scale = Math.min(window.devicePixelRatio || 1, 2);
						width = window.innerWidth;
						height = window.innerHeight;
						canvas.width = width * scale;
						canvas.height = height * scale;
						canvas.style.width = `${width}px`;
						canvas.style.height = `${height}px`;
						ctx.setTransform(scale, 0, 0, scale, 0, 0);
					};
					resize();
					for (let i = 0; i < Math.min(40, Math.floor(width / 35)); i++) {
						particles.push({ x: Math.random() * width, y: Math.random() * height, vx: (Math.random() - 0.5) * 0.35, vy: (Math.random() - 0.5) * 0.35, radius: Math.random() * 1.5 + 0.8 });
					}
					const state = { canvas, frame: 0, resize };
					window.__siteCanvasState = state;
					window.addEventListener('resize', resize, { passive: true });
					const animate = () => {
						ctx.clearRect(0, 0, width, height);
						for (let i = 0; i < particles.length; i++) {
							const p = particles[i];
							p.x += p.vx; p.y += p.vy;
							if (p.x < 0 || p.x > width) p.vx *= -1;
							if (p.y < 0 || p.y > height) p.vy *= -1;
							ctx.beginPath(); ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
							ctx.fillStyle = 'rgba(99, 102, 241, 0.35)'; ctx.fill();
							for (let j = i + 1; j < particles.length; j++) {
								const q = particles[j];
								const dx = p.x - q.x; const dy = p.y - q.y; const distance = Math.hypot(dx, dy);
								if (distance < 120) {
									ctx.beginPath(); ctx.strokeStyle = `rgba(99, 102, 241, ${0.12 * (1 - distance / 120)})`;
									ctx.lineWidth = 0.75; ctx.moveTo(p.x, p.y); ctx.lineTo(q.x, q.y); ctx.stroke();
								}
							}
						}
						state.frame = requestAnimationFrame(animate);
					};
					state.frame = requestAnimationFrame(animate);
				}
			}

			document.querySelectorAll('.visual-showcase-frame').forEach(frame => frame.classList.add('zoomable-frame'));
		};

		document.addEventListener('mousemove', event => {
			const card = event.target.closest?.('.spotlight-card');
			if (!card) return;
			const rect = card.getBoundingClientRect();
			card.style.setProperty('--mouse-x', `${event.clientX - rect.left}px`);
			card.style.setProperty('--mouse-y', `${event.clientY - rect.top}px`);
		});

		document.addEventListener('click', event => {
			const closeButton = event.target.closest?.('.lightbox-close-btn');
			const modal = event.target.closest?.('#global-lightbox-modal');
			if (closeButton || (modal && event.target === modal)) { closeLightbox(); return; }
			const frame = event.target.closest?.('.visual-showcase-frame');
			if (!frame || event.target.closest('a, button')) return;
			const image = frame.querySelector('.visual-showcase-img');
			if (!image) return;
			let lightbox = document.getElementById('global-lightbox-modal');
			if (!lightbox) {
				lightbox = document.createElement('div');
				lightbox.id = 'global-lightbox-modal'; lightbox.className = 'lightbox-modal';
				lightbox.setAttribute('role', 'dialog'); lightbox.setAttribute('aria-modal', 'true');
				lightbox.setAttribute('aria-label', 'Expanded image');
				lightbox.innerHTML = '<div class="lightbox-content"><button class="lightbox-close-btn" aria-label="Close dialog">&times;</button><img class="lightbox-image" alt="" /><div class="lightbox-caption-text"></div></div>';
				document.body.appendChild(lightbox);
			}
			const expandedImage = lightbox.querySelector('.lightbox-image');
			lightboxTrigger = frame;
			expandedImage.src = image.src; expandedImage.alt = image.alt;
			const title = frame.querySelector('.visual-caption-title')?.textContent || '';
			const description = frame.querySelector('.visual-caption-desc')?.textContent || '';
			lightbox.querySelector('.lightbox-caption-text').textContent = [title, description].filter(Boolean).join(' — ');
			lightbox.classList.add('active'); document.body.style.overflow = 'hidden';
			lightbox.querySelector('.lightbox-close-btn').focus();
		});
		document.addEventListener('keydown', event => {
			if (event.key === 'Escape') closeLightbox();
			if (event.key === 'Tab' && document.getElementById('global-lightbox-modal')?.classList.contains('active')) {
				event.preventDefault();
				document.querySelector('#global-lightbox-modal .lightbox-close-btn')?.focus();
			}
		});
		document.addEventListener('astro:page-load', setupPageInteractions);
		setupPageInteractions();
	})();
</script>

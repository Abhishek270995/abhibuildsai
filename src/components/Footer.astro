---
const today = new Date();
---

<footer class="site-footer">
	<div class="footer-container">
		<div class="footer-grid">
			<!-- Brand Info Column -->
			<div class="footer-brand-col">
				<div class="footer-brand-header">
					<div class="footer-brand-icon">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="4" y="4" width="16" height="16" rx="2"></rect>
							<rect x="9" y="9" width="6" height="6"></rect>
							<line x1="9" y1="1" x2="9" y2="4"></line>
							<line x1="15" y1="1" x2="15" y2="4"></line>
							<line x1="9" y1="20" x2="9" y2="23"></line>
							<line x1="15" y1="20" x2="15" y2="23"></line>
							<line x1="20" y1="9" x2="23" y2="9"></line>
							<line x1="20" y1="14" x2="23" y2="14"></line>
							<line x1="1" y1="9" x2="4" y2="9"></line>
							<line x1="1" y1="14" x2="4" y2="14"></line>
						</svg>
					</div>
					<div class="footer-brand-title">
						Abhi Builds <span class="accent-gradient-text">AI</span>
					</div>
				</div>
				<div class="footer-brand-sub">
					Data Analytics &amp; Autonomous AI Systems
				</div>
				<p class="footer-brand-bio">
					Turning complex, high-volume data into reliable intelligence and automated workflows.
				</p>
			</div>

			<!-- Navigation Column -->
			<div class="footer-links-col">
				<h4 class="footer-col-heading">Navigation</h4>
				<ul class="footer-links-list">
					<li><a href="/">Home</a></li>
					<li><a href="/about">About</a></li>
					<li><a href="/services">Services</a></li>
				</ul>
			</div>

			<!-- Showcase Column -->
			<div class="footer-links-col">
				<h4 class="footer-col-heading">Showcase</h4>
				<ul class="footer-links-list">
					<li><a href="/work">Case Studies</a></li>
					<li><a href="/tool">Free AI Tool</a></li>
					<li><a href="/blog">Newsletter</a></li>
				</ul>
			</div>

			<!-- Connect Column -->
			<div class="footer-links-col">
				<h4 class="footer-col-heading">Connect</h4>
				<ul class="footer-links-list">
					<li>
						<a href="mailto:abhiibuildsai@gmail.com" class="email-link">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
								<polyline points="22,6 12,13 2,6"></polyline>
							</svg>
							<span>abhiibuildsai@gmail.com</span>
						</a>
					</li>
					<li><a href="https://linkedin.com" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></li>
					<li><a href="https://github.com" target="_blank" rel="noopener noreferrer">GitHub ↗</a></li>
				</ul>
			</div>
		</div>

		<!-- Footer Bottom Bar -->
		<div class="footer-bottom-bar">
			<div class="footer-copyright">
				&copy; {today.getFullYear()} Abhishek Kumar Singh. All rights reserved.
			</div>
			<div class="footer-tech-tag">
				Built with modern Astro &amp; dark glass aesthetics.
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		width: 100%;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		background: #06070a;
		padding: 4.5rem 1.5rem 2.5rem 1.5rem;
		position: relative;
		z-index: 10;
		box-sizing: border-box;
	}

	.footer-container {
		max-width: 1080px;
		margin: 0 auto;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
		gap: 2.5rem;
		padding-bottom: 3.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}

	.footer-brand-col {
		display: flex;
		flex-direction: column;
	}

	.footer-brand-header {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin-bottom: 0.4rem;
	}

	.footer-brand-icon {
		width: 28px;
		height: 28px;
		border-radius: 0.5rem;
		background: rgba(99, 102, 241, 0.2);
		border: 1px solid rgba(99, 102, 241, 0.35);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--brand-400);
		flex-shrink: 0;
	}

	.footer-brand-title {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.2rem;
		color: #ffffff;
		line-height: 1.2;
	}

	.footer-brand-sub {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--brand-cyan-light);
		letter-spacing: 0.05em;
		text-transform: uppercase;
		margin-bottom: 0.85rem;
	}

	.footer-brand-bio {
		font-size: 0.9rem;
		color: var(--text-muted);
		line-height: 1.65;
		margin: 0;
		max-width: 320px;
	}

	.footer-links-col {
		display: flex;
		flex-direction: column;
	}

	.footer-col-heading {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: #ffffff;
		margin: 0 0 1.2rem 0;
	}

	.footer-links-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.footer-links-list li {
		margin: 0;
		padding: 0;
	}

	.footer-links-list a {
		font-size: 0.9rem;
		color: #9ca3af;
		text-decoration: none;
		transition: all 0.2s ease;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.footer-links-list a:hover {
		color: #ffffff;
		transform: translateX(2px);
		text-shadow: 0 0 10px rgba(129, 140, 248, 0.5);
	}

	.email-link {
		color: var(--brand-400) !important;
		word-break: break-all;
	}

	.footer-bottom-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 2rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.footer-copyright {
		color: #9ca3af;
	}

	.footer-tech-tag {
		color: #4b5563;
	}

	@media (max-width: 860px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
			gap: 2.5rem;
		}
		.footer-brand-col {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 540px) {
		.footer-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.footer-bottom-bar {
			flex-direction: column;
			gap: 0.75rem;
			text-align: center;
		}
	}
</style>

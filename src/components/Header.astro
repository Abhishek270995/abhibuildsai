---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
---

<header id="navbar">
	<div class="nav-container glass-panel">
		<!-- Brand Logo -->
		<a href="/" class="brand-logo">
			<div class="logo-icon-wrap">
				<div class="logo-icon-inner">
					<svg class="logo-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect x="4" y="4" width="16" height="16" rx="2"></rect>
						<rect x="9" y="9" width="6" height="6"></rect>
						<line x1="9" y1="1" x2="9" y2="4"></line>
						<line x1="15" y1="1" x2="15" y2="4"></line>
						<line x1="9" y1="20" x2="9" y2="23"></line>
						<line x1="15" y1="20" x2="15" y2="23"></line>
						<line x1="20" y1="9" x2="23" y2="9"></line>
						<line x1="20" y1="14" x2="23" y2="14"></line>
						<line x1="1" y1="9" x2="4" y2="9"></line>
						<line x1="1" y1="14" x2="4" y2="14"></line>
					</svg>
				</div>
			</div>
			<div class="brand-text">
				<span class="brand-name">Abhi Builds <span class="accent-gradient-text">AI</span></span>
				<span class="brand-sub">Data &amp; AI Systems</span>
			</div>
		</a>

		<!-- Desktop Navigation Links -->
		<nav class="desktop-nav">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/services">Services</HeaderLink>
			<HeaderLink href="/work">Work</HeaderLink>
			<HeaderLink href="/tool">
				<span>Tool</span>
				<span class="live-pill">Live</span>
			</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
		</nav>

		<!-- Header Actions -->
		<div class="header-actions">
			<a href="mailto:abhiibuildsai@gmail.com" class="cta-btn">
				<span>Get in Touch</span>
				<svg class="sparkle-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
				</svg>
			</a>

			<!-- Mobile Menu Toggle Button -->
			<button class="mobile-toggle-btn" id="mobile-toggle" aria-label="Toggle Navigation Menu">
				<svg class="menu-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<line x1="3" y1="12" x2="21" y2="12"></line>
					<line x1="3" y1="6" x2="21" y2="6"></line>
					<line x1="3" y1="18" x2="21" y2="18"></line>
				</svg>
			</button>
		</div>
	</div>

	<!-- Mobile Drawer Menu -->
	<div class="mobile-drawer glass-panel" id="mobile-drawer">
		<a href="/" class="mobile-nav-link">Home</a>
		<a href="/about" class="mobile-nav-link">About</a>
		<a href="/services" class="mobile-nav-link">Services</a>
		<a href="/work" class="mobile-nav-link">Work</a>
		<a href="/tool" class="mobile-nav-link flex-row-between">
			<span>Free AI Tool</span>
			<span class="live-pill">Live</span>
		</a>
		<a href="/blog" class="mobile-nav-link">Blog</a>
		<a href="mailto:abhiibuildsai@gmail.com" class="btn-primary mobile-cta">
			<span>Let's Talk →</span>
		</a>
	</div>
</header>

<script is:inline>
	const toggleBtn = document.getElementById('mobile-toggle');
	const drawer = document.getElementById('mobile-drawer');

	if (toggleBtn && drawer) {
		toggleBtn.addEventListener('click', () => {
			drawer.classList.toggle('is-open');
		});
	}
</script>

<style>
	header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 50;
		padding: 1rem 1.25rem;
		transition: all 0.3s ease;
		pointer-events: none;
	}

	.nav-container {
		max-width: 1080px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.65rem 1.25rem;
		background: rgba(11, 13, 20, 0.85);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 1rem;
		box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
		pointer-events: auto;
	}

	.brand-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		flex-shrink: 0;
	}

	.logo-icon-wrap {
		width: 36px;
		height: 36px;
		min-width: 36px;
		min-height: 36px;
		max-width: 36px;
		max-height: 36px;
		border-radius: 0.65rem;
		background: linear-gradient(135deg, var(--brand-500), #4f46e5, var(--brand-cyan));
		padding: 1px;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 0 15px rgba(99, 102, 241, 0.3);
		transition: transform 0.3s ease;
		flex-shrink: 0;
		overflow: hidden;
	}

	.brand-logo:hover .logo-icon-wrap {
		transform: scale(1.05);
	}

	.logo-icon-inner {
		width: 100%;
		height: 100%;
		background: var(--bg-dark-900);
		border-radius: calc(0.65rem - 1px);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.logo-svg {
		width: 18px !important;
		height: 18px !important;
		min-width: 18px !important;
		min-height: 18px !important;
		max-width: 18px !important;
		max-height: 18px !important;
		stroke: var(--brand-400);
		display: block;
		flex-shrink: 0;
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		flex-shrink: 0;
	}

	.brand-name {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.05rem;
		color: #ffffff;
		line-height: 1.15;
		letter-spacing: -0.01em;
	}

	.brand-sub {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.desktop-nav {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	.live-pill {
		margin-left: 0.35rem;
		padding: 0.1rem 0.4rem;
		font-size: 0.65rem;
		border-radius: 9999px;
		background: rgba(99, 102, 241, 0.2);
		border: 1px solid rgba(99, 102, 241, 0.35);
		color: var(--brand-400);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.cta-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.5rem 1rem;
		border-radius: 0.65rem;
		background: rgba(16, 19, 29, 0.85);
		border: 1px solid rgba(99, 102, 241, 0.35);
		color: #ffffff !important;
		font-size: 0.85rem;
		font-weight: 600;
		text-decoration: none;
		box-shadow: 0 4px 15px -3px rgba(99, 102, 241, 0.2);
		transition: all 0.25s ease;
	}

	.cta-btn:hover {
		background: rgba(99, 102, 241, 0.2);
		border-color: var(--brand-400);
		box-shadow: 0 6px 20px -3px rgba(99, 102, 241, 0.35);
		transform: translateY(-1px);
	}

	.sparkle-icon {
		width: 14px !important;
		height: 14px !important;
		min-width: 14px !important;
		min-height: 14px !important;
		stroke: var(--brand-400);
		transition: transform 0.3s ease;
		display: block;
		flex-shrink: 0;
	}

	.cta-btn:hover .sparkle-icon {
		transform: rotate(15deg) scale(1.1);
	}

	.mobile-toggle-btn {
		display: none;
		background: transparent;
		border: none;
		color: var(--text-secondary);
		cursor: pointer;
		padding: 0.35rem;
	}

	.mobile-toggle-btn:hover {
		color: #ffffff;
	}

	.menu-icon {
		width: 22px !important;
		height: 22px !important;
		min-width: 22px !important;
		min-height: 22px !important;
		display: block;
		flex-shrink: 0;
	}

	.mobile-drawer {
		display: none;
		max-width: 1080px;
		margin: 0.5rem auto 0 auto;
		padding: 1.25rem;
		background: rgba(11, 13, 20, 0.95);
		flex-direction: column;
		gap: 0.75rem;
		border-radius: 1rem;
		pointer-events: auto;
	}

	.mobile-drawer.is-open {
		display: flex;
	}

	.mobile-nav-link {
		color: #d1d5db;
		padding: 0.5rem 0.75rem;
		border-radius: 0.5rem;
		font-size: 0.95rem;
		font-weight: 500;
	}

	.mobile-nav-link:hover {
		background: rgba(255, 255, 255, 0.05);
		color: #ffffff;
	}

	.flex-row-between {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.mobile-cta {
		width: 100%;
		margin-top: 0.5rem;
		font-size: 0.85rem;
		padding: 0.65rem;
	}

	@media (max-width: 820px) {
		.desktop-nav {
			display: none;
		}
		.mobile-toggle-btn {
			display: block;
		}
	}
</style>

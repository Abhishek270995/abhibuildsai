---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body class="bg-grid">
		<canvas id="bg-canvas" class="fixed-canvas" aria-hidden="true"></canvas>
		<div class="ambient-glow-1" aria-hidden="true"></div>
		<div class="ambient-glow-2" aria-hidden="true"></div>

		<Header />
		<main>
			<article class="article-container">
				<div class="back-nav mb-6">
					<a href="/blog" class="back-link">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<line x1="19" y1="12" x2="5" y2="12"></line>
							<polyline points="12 19 5 12 12 5"></polyline>
						</svg>
						<span>Back to Newsletter &amp; Blog</span>
					</a>
				</div>

				{
					heroImage && (
						<div class="hero-image-wrap glass-panel mb-8">
							<Image
								width={1020}
								height={510}
								src={heroImage}
								alt=""
								class="hero-img"
							/>
						</div>
					)
				}

				<div class="glass-panel prose-card">
					<header class="article-header">
						<div class="article-meta">
							<div class="badge-pill">
								<FormattedDate date={pubDate} />
							</div>
							{
								updatedDate && (
									<span class="last-updated">
										Updated on <FormattedDate date={updatedDate} />
									</span>
								)
							}
						</div>
						<h1 class="gradient-text article-title">{title}</h1>
						<hr class="header-divider" />
					</header>

					<div class="prose">
						<slot />
					</div>

					<!-- Post-Article Advisory CTA -->
					<div class="article-advisory-cta">
						<div class="badge-pill mb-3">
							<span class="pulse-dot"></span>
							<span>1-ON-1 DATA ADVISORY</span>
						</div>
						<h3>Dealing with similar data or SQL bottlenecks?</h3>
						<p>
							Book 30 minutes with Abhishek to review your queries, reconcile conflicting metrics, or optimize your data stack — no commitment beyond the call.
						</p>
						<div class="advisory-cta-action">
							<div class="cta-price-tag">
								<span class="price-val">$75</span>
								<span class="price-time">· 30 minutes</span>
							</div>
							<a
								href="https://calendly.com/abhiibuildsai/30min"
								target="_blank"
								rel="noopener noreferrer"
								class="btn-primary"
							>
								<span>Book 30-Min Call →</span>
							</a>
						</div>
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.fixed-canvas {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		pointer-events: none;
		z-index: 0;
		opacity: 0.5;
	}

	.article-container {
		max-width: 820px;
		margin: 0 auto;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--brand-400);
		text-decoration: none;
		transition: transform 0.2s ease, color 0.2s ease;
	}

	.back-link:hover {
		color: #ffffff;
		transform: translateX(-4px);
	}

	.hero-image-wrap {
		width: 100%;
		border-radius: 1.25rem;
		overflow: hidden;
		padding: 0;
	}

	.hero-img {
		width: 100%;
		height: auto;
		display: block;
	}

	.prose-card {
		padding: 3.5rem 3rem;
		background: rgba(16, 19, 29, 0.75);
	}

	.article-header {
		margin-bottom: 2.5rem;
	}

	.article-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}

	.last-updated {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.article-title {
		font-size: clamp(2rem, 4.5vw, 2.75rem);
		line-height: 1.2;
		margin: 0 0 1.5rem 0;
	}

	.header-divider {
		border: none;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		margin: 0;
	}

	.article-advisory-cta {
		margin-top: 3.5rem;
		padding: 2.25rem 2rem;
		background: linear-gradient(135deg, rgba(20, 24, 38, 0.9), rgba(12, 15, 24, 0.95));
		border: 1px solid rgba(99, 102, 241, 0.35);
		border-radius: 1rem;
		box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
	}

	.article-advisory-cta h3 {
		font-size: 1.35rem;
		color: #ffffff;
		margin-bottom: 0.6rem;
		line-height: 1.3;
	}

	.article-advisory-cta p {
		font-size: 0.98rem;
		color: #cbd5e1;
		line-height: 1.6;
		margin-bottom: 1.5rem;
	}

	.advisory-cta-action {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		flex-wrap: wrap;
		padding-top: 1.25rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}

	.cta-price-tag {
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
	}

	.price-val {
		font-family: var(--font-display);
		font-size: 1.85rem;
		font-weight: 800;
		color: #ffffff;
		line-height: 1;
	}

	.price-time {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--text-secondary);
		font-weight: 500;
	}

	@media (max-width: 640px) {
		.prose-card {
			padding: 2rem 1.5rem;
		}

		.article-advisory-cta {
			padding: 1.75rem 1.25rem;
		}

		.advisory-cta-action {
			flex-direction: column;
			align-items: flex-start;
		}

		.advisory-cta-action .btn-primary {
			width: 100%;
			text-align: center;
			justify-content: center;
		}
	}
</style>

---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`Services & Engagements | ${SITE_TITLE}`}
            description="Fixed-scope data engineering sprints and bespoke analytics advisory by Abhishek Kumar Singh."
        />
    </head>
    <body class="bg-grid">
        <canvas id="bg-canvas" class="fixed-canvas" aria-hidden="true"></canvas>
        <div class="ambient-glow-1" aria-hidden="true"></div>
        <div class="ambient-glow-2" aria-hidden="true"></div>

        <Header />
        <main>
            <div class="services-container">
                <!-- Page Top Header -->
                <div class="header-section">
                    <div class="badge-pill mb-4">
                        <span class="pulse-dot"></span>
                        <span>SPRINTS &amp; BESPOKE ADVISORY</span>
                    </div>

                    <h1 class="gradient-text page-title">Services &amp; Engagements</h1>
                    <p class="page-intro">
                        High-conviction data engineering, single-source-of-truth architectures, and revenue analytics. Choose a fixed-scope productized sprint or partner on a bespoke advisory basis.
                    </p>
                </div>

                <!-- SECTION 1: FIXED-SCOPE PACKAGES -->
                <section class="packages-section mb-16">
                    <div class="section-heading-wrap">
                        <div class="section-badge">PRODUCTIZED SPRINTS</div>
                        <h2 class="section-title">Fixed-Scope Engagements</h2>
                        <p class="section-subtitle">
                            Predictable pricing, concrete deliverables, and rapid turnaround. Zero scope creep or surprise billing.
                        </p>
                    </div>

                    <div class="packages-grid">
                        <!-- Package 1: Data Quality Audit -->
                        <div class="package-card glass-panel glass-panel-hover">
                            <div class="package-header">
                                <div class="package-tag-row">
                                    <span class="badge-category pkg-cat-emerald">DATA AUDIT</span>
                                    <span class="timeline-badge">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 14 14"></polyline>
                                        </svg>
                                        1–2 Weeks
                                    </span>
                                </div>
                                <h3 class="package-name">Data Quality &amp; Anomaly Audit</h3>
                                <p class="package-summary">
                                    Root-cause diagnostic for broken metrics, silent pipeline failures, and warehouse discrepancies.
                                </p>
                                <div class="price-box">
                                    <div class="price-value">$2,400</div>
                                    <div class="price-meta">Fixed Price · Complete Delivery</div>
                                </div>
                            </div>

                            <div class="deliverables-divider"></div>

                            <div class="deliverables-section">
                                <div class="deliverables-title">WHAT'S INCLUDED:</div>
                                <ul class="deliverables-list">
                                    <li>
                                        <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                        </svg>
                                        <span><strong>Full Warehouse Diagnostic:</strong> Scan BigQuery, Snowflake, or PostgreSQL tables for nulls, duplicates &amp; orphan keys.</span>
                                    </li>
                                    <li>
                                        <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                        </svg>
                                        <span><strong>Automated Anomaly Tests:</strong> Production-ready SQL/dbt assertion suite targeting up to 15 critical data models.</span>
                                    </li>
                                    <li>
                                        <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                        </svg>
                                        <span><strong>Health Scorecard &amp; Roadmap:</strong> Prioritized action matrix of high, medium, and low severity data risks.</span>
                                    </li>
                                    <li>
                                        <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                        </svg>
                                        <span><strong>Executive Readout Call:</strong> One 60-min walkthrough with engineering and analytics stakeholders.</span>
                                    </li>
                                </ul>

                                <p class="package-scope-note">
                                    *Scope covers one data warehouse environment. Additional environments or systems quoted separately.
                                </p>
                            </div>

                            <a href="mailto:abhiibuildsai@gmail.com?subject=Get%20Started%20-%20Data%20Quality%20Audit%20Package" class="btn-outline-pkg">
                                <span>Get Started with Audit →</span>
                            </a>
                        </div>

                        <!-- Package 2: SSOT Sprint (Featured) -->
                        <div class="package-card glass-panel glass-panel-hover featured-package">
                            <div class="floating-featured-badge">
                                <span class="badge-sparkle">✦</span>
                                <span>MOST POPULAR · FOUNDATIONAL</span>
                            </div>

                            <div class="package-header">
                                <div class="package-tag-row">
                                    <span class="badge-category pkg-cat-indigo">SSOT SPRINT</span>
                                    <span class="timeline-badge timeline-highlight">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 14 14"></polyline>
                                        </svg>
                                        2–3 Weeks
                                    </span>
                                </div>
                                <h3 class="package-name">SSOT Implementation Sprint</h3>
                                <p class="package-summary">
                                    Establish a trusted Single Source of Truth architecture eliminating conflicting numbers across teams.
                                </p>
                                <div class="price-box">
                                    <div class="price-value">$4,800</div>
                                    <div class="price-meta">Fixed Price · Complete Delivery</div>
                                </div>
                            </div>

                            <div class="deliverables-divider"></div>

                            <div class="deliverables-section">
                                <div class="deliverables-title">WHAT'S INCLUDED:</div>
                                <ul class="deliverables-list">
                                    <li>
                                        <svg class="check-icon text-indigo" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                        </svg>
                                        <span><strong>Unified Modeling Layer:</strong> Clean dimensional schema &amp; modular dbt transformations, covering up to 20 core tables.</span>
                                    </li>
                                    <li>
                                        <svg class="check-icon text-indigo" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                        </svg>
                                        <span><strong>Canonical Metric Definitions:</strong> Standardized logic for up to 5 core metrics (e.g. Revenue, Retention, CAC, LTV, Active Users).</span>
                                    </li>
                                    <li>
                                        <svg class="check-icon text-indigo" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                        </svg>
                                        <span><strong>Automated Alerts:</strong> Real-time Slack/Email alerts on anomaly threshold breaches or failed syncs, configured for up to 10 monitored checks.</span>
                                    </li>
                                    <li>
                                        <svg class="check-icon text-indigo" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                        </svg>
                                        <span><strong>Documentation &amp; Handover:</strong> Clean data dictionary, schema diagram, and async team walkthrough.</span>
                                    </li>
                                </ul>
                            </div>

                            <a href="mailto:abhiibuildsai@gmail.com?subject=Get%20Started%20-%20SSOT%20Implementation%20Sprint" class="btn-primary-pkg">
                                <span>Get Started with SSOT Sprint →</span>
                            </a>
                        </div>

                        <!-- Package 3: Revenue Intelligence Engine -->
                        <div class="package-card glass-panel glass-panel-hover">
                            <div class="package-header">
                                <div class="package-tag-row">
                                    <span class="badge-category pkg-cat-cyan">REVENUE OPS</span>
                                    <span class="timeline-badge">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 14 14"></polyline>
                                        </svg>
                                        3–4 Weeks
                                    </span>
                                </div>
                                <h3 class="package-name">Revenue &amp; Pipeline Engine</h3>
                                <p class="package-summary">
                                    Variance analytics, quota-risk detection, and executive forecasting to protect quarterly targets.
                                </p>
                                <div class="price-box">
                                    <div class="price-value">$6,500</div>
                                    <div class="price-meta">Fixed Price · Complete Delivery</div>
                                </div>
                            </div>

                            <div class="deliverables-divider"></div>

                            <div class="deliverables-section">
                                <div class="deliverables-title">WHAT'S INCLUDED:</div>
                                <ul class="deliverables-list">
                                    <li>
                                        <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                        </svg>
                                        <span><strong>Variance Analysis Framework:</strong> Automated Actuals vs. Booked vs. Pipeline reconciliation model.</span>
                                    </li>
                                    <li>
                                        <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                        </svg>
                                        <span><strong>Quota Risk Detection:</strong> Pipeline coverage ratio models covering up to 3 revenue segments or regions, flagging at-risk revenue weeks before quarter close.</span>
                                    </li>
                                    <li>
                                        <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                        </svg>
                                        <span><strong>Executive BI Suite:</strong> Interactive dashboard built in <strong>one</strong> platform of your choice (Power BI, Metabase, or Tableau).</span>
                                    </li>
                                    <li>
                                        <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                        </svg>
                                        <span><strong>Post-Launch Support:</strong> Up to 3 check-in sessions over 2 weeks for threshold tuning and team walkthroughs.</span>
                                    </li>
                                </ul>
                            </div>

                            <a href="mailto:abhiibuildsai@gmail.com?subject=Get%20Started%20-%20Revenue%20Intelligence%20Package" class="btn-outline-pkg">
                                <span>Get Started with Revenue Engine →</span>
                            </a>
                        </div>
                    </div>

                    <!-- Shared Reassurance Banner -->
                    <div class="packages-reassurance">
                        <svg class="reassurance-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        <span>Scope beyond what's listed above is quoted separately — no surprise fees, just a clear conversation first.</span>
                    </div>

                    <!-- 1-on-1 Advisory Call Block -->
                    <div class="advisory-call-card glass-panel spotlight-card glass-panel-hover">
                        <div class="advisory-left">
                            <div class="advisory-badge">
                                <span class="pulse-dot"></span>
                                <span>1-ON-1 PROBLEM SOLVING</span>
                            </div>
                            <h3 class="advisory-heading">Not ready for a full engagement?</h3>
                            <p class="advisory-body">
                                Book 30 minutes to talk through a specific data or AI problem — no commitment beyond the call.
                            </p>
                        </div>
                        <div class="advisory-right">
                            <div class="advisory-price-tag">
                                <span class="advisory-price">$75</span>
                                <span class="advisory-duration">· 30 minutes</span>
                            </div>
                            <a
                                href="https://calendly.com/abhiibuildsai/30min"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="btn-primary advisory-btn"
                            >
                                <span>Book 30-Min Call →</span>
                            </a>
                        </div>
                    </div>
                </section>

                <!-- SECTION 2: CUSTOM & BROADER SERVICES -->
                <section class="custom-services-section mb-16">
                    <div class="section-heading-wrap">
                        <div class="section-badge">CUSTOM SCOPES &amp; ADVISORY</div>
                        <h2 class="section-title">Bespoke Analytics &amp; Applied AI</h2>
                        <p class="section-subtitle">
                            For complex multi-touch models, proprietary warehouse architectures, or fractional analytics leadership.
                        </p>
                    </div>

                    <!-- 4 Service Spotlight Cards Grid -->
                    <div class="services-grid">
                        <!-- Service 1 -->
                        <div class="spotlight-card glass-panel glass-panel-hover service-card">
                            <div class="service-icon-wrap icon-indigo">
                                <span class="service-num">01</span>
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="18" y1="20" x2="18" y2="10"></line>
                                    <line x1="12" y1="20" x2="12" y2="4"></line>
                                    <line x1="6" y1="20" x2="6" y2="14"></line>
                                </svg>
                            </div>
                            <span class="badge-category">REVENUE &amp; PIPELINE</span>
                            <h2>Revenue &amp; Commercial Analytics</h2>
                            <p>
                                Custom forecasting models, cross-platform spend benchmarking, and executive dashboards built across SQL, BigQuery, Power BI, and Metabase — tailored to unique sales cycles and contract structures.
                            </p>
                            <div class="tags-row">
                                <span class="badge-tag">SQL</span>
                                <span class="badge-tag">BigQuery</span>
                                <span class="badge-tag">Power BI</span>
                                <span class="badge-tag">Metabase</span>
                            </div>
                        </div>

                        <!-- Service 2 -->
                        <div class="spotlight-card glass-panel glass-panel-hover service-card">
                            <div class="service-icon-wrap icon-emerald">
                                <span class="service-num">02</span>
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                </svg>
                            </div>
                            <span class="badge-category">SSOT &amp; MONITORING</span>
                            <h2>Data Integrity &amp; Warehousing</h2>
                            <p>
                                Elimination of conflicting numbers and manual firefighting. Custom ELT pipelines, automated reconciliation workflows, and robust audit mechanisms that safeguard data pipelines before it reaches decision-makers.
                            </p>
                            <div class="tags-row">
                                <span class="badge-tag">dbt Core</span>
                                <span class="badge-tag">Anomaly Detection</span>
                                <span class="badge-tag">Data Governance</span>
                            </div>
                        </div>

                        <!-- Service 3 -->
                        <div class="spotlight-card glass-panel glass-panel-hover service-card">
                            <div class="service-icon-wrap icon-cyan">
                                <span class="service-num">03</span>
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                            </div>
                            <span class="badge-category">USER BEHAVIOR</span>
                            <h2>Product &amp; Behavioral Analytics</h2>
                            <p>
                                Funnel drop-off diagnostics, retention cohort modeling, and feature engagement telemetry. The analytical foundation that lifted Novatr course completion by +25% by isolating exact friction points.
                            </p>
                            <div class="tags-row">
                                <span class="badge-tag">Cohort Analysis</span>
                                <span class="badge-tag">Funnel Optimization</span>
                                <span class="badge-tag">User Retention</span>
                            </div>
                        </div>

                        <!-- Service 4 -->
                        <div class="spotlight-card glass-panel glass-panel-hover service-card">
                            <div class="service-icon-wrap icon-violet">
                                <span class="service-num">04</span>
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="4" y="4" width="16" height="16" rx="2"></rect>
                                    <rect x="9" y="9" width="6" height="6"></rect>
                                    <line x1="9" y1="1" x2="9" y2="4"></line>
                                    <line x1="15" y1="1" x2="15" y2="4"></line>
                                    <line x1="9" y1="20" x2="9" y2="23"></line>
                                    <line x1="15" y1="20" x2="15" y2="23"></line>
                                </svg>
                            </div>
                            <span class="badge-category">PRACTICAL AI</span>
                            <h2>Applied AI &amp; Agentic Workflows</h2>
                            <p>
                                Production AI utilities, automated SQL copilots, and intelligent data cleansing agents. Backed by Anthropic's AI Fluency and Claude 101 credentials, built to turn time-intensive manual workflows into instant automated systems.
                            </p>
                            <div class="tags-row">
                                <span class="badge-tag">Claude 101 Certified</span>
                                <span class="badge-tag">Agentic Workflows</span>
                                <span class="badge-tag">AI Copilots</span>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- SECTION 3: HOW WE'D WORK TOGETHER -->
                <div class="spotlight-card glass-panel collaboration-card">
                    <div class="badge-pill mb-3">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 14 14"></polyline>
                        </svg>
                        <span>ENGAGEMENT PROCESS</span>
                    </div>
                    <h2>How We'll Work Together</h2>
                    <p class="collab-desc">
                        Every collaboration begins with a concise 30-minute discovery call to unpack your actual bottleneck — not just the surface symptoms. From there, we select the right model: a fixed-scope sprint for immediate impact, a bespoke build, or a fractional retainer for continuous high-leverage data execution.
                    </p>

                    <div class="process-steps-grid">
                        <div class="step-item">
                            <span class="step-num">01</span>
                            <h4>Discovery Call</h4>
                            <p>Map core metrics, warehouse stack, and key friction points.</p>
                        </div>
                        <div class="step-item">
                            <span class="step-num">02</span>
                            <h4>Sprint Scope</h4>
                            <p>Agree on fixed deliverables, exact timeline, and milestone check-ins.</p>
                        </div>
                        <div class="step-item">
                            <span class="step-num">03</span>
                            <h4>Rapid Execution</h4>
                            <p>Direct SQL/dbt builds, dashboard delivery, and daily async updates.</p>
                        </div>
                        <div class="step-item">
                            <span class="step-num">04</span>
                            <h4>Handover &amp; Enablement</h4>
                            <p>Walkthrough calls, documented schemas, and post-launch monitoring.</p>
                        </div>
                    </div>

                    <div class="collab-action">
                        <div>
                            <span class="action-question">Need a custom scope or have questions about a package?</span>
                            <span class="action-sub">Let's talk through your data architecture.</span>
                        </div>
                        <a href="mailto:abhiibuildsai@gmail.com?subject=Consulting%20Inquiry%20-%20Custom%20Scope%20or%20Package" class="btn-primary">
                            <span>Get in Touch →</span>
                        </a>
                    </div>
                </div>
            </div>
        </main>
        <Footer />
    </body>
</html>

<style>
    .fixed-canvas {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        z-index: 0;
        opacity: 0.5;
    }

    .services-container {
        max-width: 1120px;
        margin: 0 auto;
        padding-top: 1rem;
    }

    .header-section {
        margin-bottom: 3.5rem;
    }

    .page-title {
        margin-bottom: 0.85rem;
        line-height: 1.15;
    }

    .page-intro {
        font-size: 1.15rem;
        color: var(--text-secondary);
        max-width: 820px;
        line-height: 1.7;
        margin-bottom: 0;
    }

    /* Section Headings */
    .section-heading-wrap {
        margin-bottom: 2.25rem;
    }

    .section-badge {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        color: var(--brand-400);
        text-transform: uppercase;
        margin-bottom: 0.5rem;
    }

    .section-title {
        font-size: 1.85rem;
        margin-bottom: 0.5rem;
        color: #ffffff;
    }

    .section-subtitle {
        font-size: 1.05rem;
        color: var(--text-secondary);
        max-width: 700px;
        margin-bottom: 0;
    }

    /* Fixed-Scope Packages Grid */
    .packages-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        align-items: stretch;
        padding-top: 1.25rem;
    }

    .package-card {
        padding: 2.25rem 1.75rem;
        display: flex;
        flex-direction: column;
        position: relative;
        background: rgba(16, 19, 29, 0.75);
        border: 1px solid var(--border-subtle);
        border-radius: 16px;
        overflow: visible;
    }

    .featured-package {

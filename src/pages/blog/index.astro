---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Newsletter & Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-grid">
		<canvas id="bg-canvas" class="fixed-canvas" aria-hidden="true"></canvas>
		<div class="ambient-glow-1" aria-hidden="true"></div>
		<div class="ambient-glow-2" aria-hidden="true"></div>

		<Header />
		<main>
			<div class="blog-container">
				<div class="badge-pill mb-4">
					<span class="pulse-dot"></span>
					<span>WEEKLY WRITING &amp; NOTES</span>
				</div>

				<h1 class="gradient-text page-title">Newsletter &amp; Articles</h1>
				<p class="page-desc">
					Weekly notes on data quality, revenue analytics, and building applied AI systems in public.
				</p>

				<section class="posts-section">
					<div class="posts-grid">
						{
							posts.map((post) => (
								<article class="spotlight-card glass-panel glass-panel-hover post-card">
									<a href={`/blog/${post.id}/`} class="post-link">
										{post.data.heroImage && (
											<div class="hero-image-wrapper">
												<Image width={720} height={360} src={post.data.heroImage} alt="" class="post-img" />
											</div>
										)}
										<div class="post-info">
											<div class="post-meta">
												<span class="date-badge">
													<FormattedDate date={post.data.pubDate} />
												</span>
												<span class="read-indicator">Read article →</span>
											</div>
											<h2 class="post-title">{post.data.title}</h2>
											{post.data.description && (
												<p class="post-summary">{post.data.description}</p>
											)}
										</div>
									</a>
								</article>
							))
						}
					</div>
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.fixed-canvas {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		pointer-events: none;
		z-index: 0;
		opacity: 0.5;
	}

	.blog-container {
		max-width: 960px;
		margin: 0 auto;
	}

	.page-title {
		margin-bottom: 0.75rem;
	}

	.page-desc {
		font-size: 1.15rem;
		color: var(--text-secondary);
		margin-bottom: 3rem;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
		gap: 2rem;
	}

	.post-card {
		padding: 0;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.post-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}

	.hero-image-wrapper {
		width: 100%;
		height: 220px;
		overflow: hidden;
		background: var(--bg-dark-900);
	}

	.post-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.post-card:hover .post-img {
		transform: scale(1.05);
	}

	.post-info {
		padding: 2rem;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	.post-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1rem;
	}

	.date-badge {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--brand-cyan-light);
	}

	.read-indicator {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--brand-400);
		transition: transform 0.2s ease;
	}

	.post-card:hover .read-indicator {
		transform: translateX(4px);
		color: #ffffff;
	}

	.post-title {
		font-size: 1.45rem;
		font-weight: 700;
		color: #ffffff;
		line-height: 1.3;
		margin-bottom: 0.85rem;
		transition: color 0.2s ease;
	}

	.post-card:hover .post-title {
		color: var(--brand-400);
	}

	.post-summary {
		font-size: 0.95rem;
		line-height: 1.6;
		color: #94a3b8;
		margin: 0;
	}

	@media (max-width: 640px) {
		.posts-grid {
			grid-template-columns: 1fr;
		}
		.post-info {
			padding: 1.5rem;
		}
	}
</style>

---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Turning messy data into decisions you can trust.</h1>
				<p>
					I'm Abhishek — a data analyst and AI builder with 6.5+ years
					across ad-tech, ed-tech, and digital commerce. I help teams
					build reliable data foundations, forecast with confidence,
					and ship practical AI tools — not hype.
				</p>
				<p>
					<a href="/work">See my work</a> &nbsp;·&nbsp; <a
						href="/blog">Read the newsletter</a
					>
				</p>
			</section>

			<section>
				<h2>What I Do</h2>
				<p>
					I work at the intersection of revenue analytics, data
					quality, and applied AI.
				</p>
				<ul>
					<li>
						<strong>Analytics & Forecasting</strong> — pipeline forecasting,
						KPI governance, dashboarding (SQL, BigQuery, Power BI, Metabase)
					</li>
					<li>
						<strong>Data Quality & SSOT Systems</strong> — building single-source-of-truth
						frameworks and anomaly detection that teams actually trust
					</li>
					<li>
						<strong>Applied AI Tooling</strong> — practical, lightweight
						AI agents and utilities, including tools that run without
						sending your data anywhere
					</li>
				</ul>
			</section>

			<section>
				<h2>Featured Work</h2>
				<h3>Revenue Data Reconciliation & Anomaly Agent</h3>
				<p>
					A monitoring system that catches data quality issues before
					they reach a dashboard — combining rule-based detection with
					AI-generated narrative summaries.
				</p>
				<p><a href="/work">Read the case study →</a></p>
			</section>

			<section>
				<h2>Try It Yourself</h2>
				<p>
					A free AI tool, right in your browser. No sign-up, no cloud,
					no data leaving your device.
				</p>
				<p><a href="/tool">Try the tool →</a></p>
			</section>

			<section>
				<h2>Newsletter</h2>
				<p>
					Weekly notes on data, AI, and building in public. Short,
					practical, no fluff.
				</p>
				<p><a href="/blog">Subscribe →</a></p>
			</section>

			<section>
				<h2>Let's Talk</h2>
				<p>
					Working on a data problem, or want a second pair of eyes on
					your analytics stack?
				</p>
				<p>
					<a href="mailto:abhiibuildsai@gmail.com"
						>abhiibuildsai@gmail.com</a
					>
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

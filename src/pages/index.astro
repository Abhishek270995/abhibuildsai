---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import SignalLine from "../components/SignalLine.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-grid">
		<!-- Background Interactive Canvas & Glow Orbs -->
		<canvas id="bg-canvas" class="fixed-canvas" aria-hidden="true"></canvas>
		<div class="ambient-glow-1" aria-hidden="true"></div>
		<div class="ambient-glow-2" aria-hidden="true"></div>
		<div class="ambient-glow-3" aria-hidden="true"></div>

		<Header />

		<main>
			<!-- HERO SECTION -->
			<section class="hero-section">
				<div class="badge-pill mb-6">
					<span class="pulse-dot"></span>
					<span>Available for Select Analytics &amp; AI Builds</span>
				</div>

				<h1 class="hero-title gradient-text">
					Turning messy data into <br />
					<span class="accent-gradient-text">decisions you can trust.</span>
				</h1>

				<SignalLine />

				<p class="hero-bio">
					I'm Abhishek — a Senior Data Analyst with 6.5+ years driving
					measurable growth across ad-tech, ed-tech, and digital
					commerce. I've helped teams grow revenue by 22%, lift course
					completion by 25%, and build the single-source-of-truth
					systems that make those numbers trustworthy in the first
					place.
				</p>

				<div class="hero-actions">
					<a href="/work" class="btn-primary">
						<span>See my work</span>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<line x1="5" y1="12" x2="19" y2="12"></line>
							<polyline points="12 5 19 12 12 19"></polyline>
						</svg>
					</a>
					<a href="/blog" class="btn-secondary">
						<span>Read the newsletter</span>
					</a>
				</div>

				<!-- Metrics Bar -->
				<div class="metrics-grid">
					<div class="metric-card glass-panel">
						<div class="metric-value text-emerald">+22%</div>
						<div class="metric-label">Revenue Growth Supported</div>
					</div>
					<div class="metric-card glass-panel">
						<div class="metric-value text-cyan">+25%</div>
						<div class="metric-label">Course Completion Lift</div>
					</div>
					<div class="metric-card glass-panel">
						<div class="metric-value text-indigo">6.5+</div>
						<div class="metric-label">Years of Experience</div>
					</div>
					<div class="metric-card glass-panel">
						<div class="metric-value text-violet">100%</div>
						<div class="metric-label">Client-Side AI Tooling</div>
					</div>
				</div>
			</section>

			<!-- WHAT I DO SECTION -->
			<section class="section-container">
				<div class="section-header">
					<div class="badge-pill mb-3">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
							<polyline points="2 17 12 22 22 17"></polyline>
							<polyline points="2 12 12 17 22 12"></polyline>
						</svg>
						<span>Core Disciplines</span>
					</div>
					<h2>What I Do</h2>
					<p class="section-desc">
						I work at the intersection of revenue analytics, data
						quality, and applied AI.
					</p>
				</div>

				<div class="bento-grid">
					<!-- Card 1: Analytics & Forecasting -->
					<div class="spotlight-card glass-panel glass-panel-hover bento-card">
						<div class="card-icon-wrap icon-indigo">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="18" y1="20" x2="18" y2="10"></line>
								<line x1="12" y1="20" x2="12" y2="4"></line>
								<line x1="6" y1="20" x2="6" y2="14"></line>
							</svg>
						</div>
						<span class="badge-category">REVENUE &amp; INSIGHTS</span>
						<h3>Analytics &amp; Forecasting</h3>
						<p>
							Pipeline forecasting, KPI governance, and stakeholder dashboarding engineered to spot trends and risks before they affect targets.
						</p>
						<div class="tags-row">
							<span class="badge-tag">SQL</span>
							<span class="badge-tag">BigQuery</span>
							<span class="badge-tag">Power BI</span>
							<span class="badge-tag">Metabase</span>
						</div>
					</div>

					<!-- Card 2: Data Quality & SSOT Systems -->
					<div class="spotlight-card glass-panel glass-panel-hover bento-card">
						<div class="card-icon-wrap icon-emerald">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
							</svg>
						</div>
						<span class="badge-category">DATA INTEGRITY</span>
						<h3>Data Quality &amp; SSOT Systems</h3>
						<p>
							Building single-source-of-truth frameworks, anomaly detection, and validation checks that teams actually trust.
						</p>
						<div class="tags-row">
							<span class="badge-tag">SSOT Frameworks</span>
							<span class="badge-tag">Anomaly Detection</span>
							<span class="badge-tag">Reconciliation</span>
						</div>
					</div>

					<!-- Card 3: Applied AI Tooling -->
					<div class="spotlight-card glass-panel glass-panel-hover bento-card">
						<div class="card-icon-wrap icon-cyan">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<rect x="4" y="4" width="16" height="16" rx="2"></rect>
								<rect x="9" y="9" width="6" height="6"></rect>
								<line x1="9" y1="1" x2="9" y2="4"></line>
								<line x1="15" y1="1" x2="15" y2="4"></line>
								<line x1="9" y1="20" x2="9" y2="23"></line>
								<line x1="15" y1="20" x2="15" y2="23"></line>
							</svg>
						</div>
						<span class="badge-category">PRACTICAL AI</span>
						<h3>Applied AI Tooling</h3>
						<p>
							Practical, lightweight AI agents and utilities, including private tools that run entirely in your browser without sending data anywhere.
						</p>
						<div class="tags-row">
							<span class="badge-tag">Private In-Browser Models</span>
							<span class="badge-tag">Claude 101 Certified</span>
							<span class="badge-tag">Automation</span>
						</div>
					</div>
				</div>
			</section>

			<!-- FEATURED WORK SECTION -->
			<section class="section-container">
				<div class="spotlight-card glass-panel glass-panel-hover featured-work-card">
					<div class="featured-work-content">
						<div class="badge-pill mb-4">
							<span class="pulse-dot"></span>
							<span>FEATURED CASE STUDY</span>
						</div>
						<h2>Revenue Data Reconciliation &amp; Anomaly Agent</h2>
						<p class="featured-desc">
							A monitoring system that catches data quality issues before
							they reach a dashboard — combining rule-based detection with
							AI-generated narrative summaries.
						</p>
						<div class="tags-row mb-6">
							<span class="badge-tag">Google Apps Script</span>
							<span class="badge-tag">Python</span>
							<span class="badge-tag">Claude Reasoning</span>
							<span class="badge-tag">Slack &amp; Email APIs</span>
						</div>
						<a href="/work" class="btn-primary">
							<span>Read the case study</span>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</a>
					</div>
				</div>
			</section>

			<!-- TRY IT YOURSELF & NEWSLETTER GRID -->
			<section class="section-container">
				<div class="two-col-grid">
					<!-- Try It Yourself Card -->
					<div class="spotlight-card glass-panel glass-panel-hover promo-card">
						<div class="card-icon-wrap icon-violet">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<polyline points="4 17 10 11 4 5"></polyline>
								<line x1="12" y1="19" x2="20" y2="19"></line>
							</svg>
						</div>
						<span class="badge-category">FREE BROWSER AI</span>
						<h3>AI SQL Optimizer</h3>
						<p>
							Optimize slow queries, eliminate expensive full-table scans,
							and translate between BigQuery, Snowflake, and PostgreSQL. 100% private.
						</p>
						<a href="/tool" class="card-link">
							<span>Try the optimizer</span>
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</a>
					</div>

					<!-- Newsletter Card -->
					<div class="spotlight-card glass-panel glass-panel-hover promo-card">
						<div class="card-icon-wrap icon-cyan">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
								<polyline points="22,6 12,13 2,6"></polyline>
							</svg>
						</div>
						<span class="badge-category">WEEKLY INSIGHTS</span>
						<h3>Newsletter</h3>
						<p>
							Weekly notes on data, AI, and building in public. Short,
							practical, no fluff.
						</p>
						<a href="/blog" class="card-link">
							<span>Subscribe</span>
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</a>
					</div>
				</div>
			</section>

			<!-- LET'S TALK / CTA SECTION -->
			<section class="section-container">
				<div class="glass-panel contact-cta-card">
					<div class="contact-cta-content">
						<div class="badge-pill mb-3">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
							</svg>
							<span>DIRECT COLLABORATION</span>
						</div>
						<h2>Let's Talk</h2>
						<p class="contact-desc">
							Working on a data problem, or want a second pair of eyes on
							your analytics stack?
						</p>
						<a href="mailto:abhiibuildsai@gmail.com" class="btn-primary email-btn">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
								<polyline points="22,6 12,13 2,6"></polyline>
							</svg>
							<span>abhiibuildsai@gmail.com</span>
						</a>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.fixed-canvas {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		pointer-events: none;
		z-index: 0;
		opacity: 0.5;
	}

	.hero-section {
		padding: 2.5rem 0 3.5rem 0;
	}

	.hero-title {
		line-height: 1.12;
		margin-bottom: 1rem;
	}

	.hero-bio {
		font-size: 1.15rem;
		line-height: 1.75;
		color: #cbd5e1;
		max-width: 820px;
		margin-bottom: 2rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-bottom: 3.5rem;
	}

	.mb-3 { margin-bottom: 0.75rem; }
	.mb-4 { margin-bottom: 1rem; }
	.mb-6 { margin-bottom: 1.5rem; }

	.metrics-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
		padding-top: 2rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}

	.metric-card {
		padding: 1.25rem 1rem;
		text-align: left;
	}

	.metric-value {
		font-family: var(--font-display);
		font-size: 2rem;
		font-weight: 800;
		line-height: 1.1;
		margin-bottom: 0.35rem;
	}

	.text-emerald { color: var(--brand-emerald); }
	.text-cyan { color: var(--brand-cyan-light); }
	.text-indigo { color: var(--brand-400); }
	.text-violet { color: var(--brand-violet-light); }

	.metric-label {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-muted);
		line-height: 1.3;
	}

	.section-container {
		margin-bottom: 4.5rem;
	}

	.section-header {
		margin-bottom: 2rem;
	}

	.section-desc {
		font-size: 1.1rem;
		color: var(--text-secondary);
	}

	.bento-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	.bento-card {
		padding: 2rem 1.75rem;
		display: flex;
		flex-direction: column;
	}

	.bento-card p {
		font-size: 0.95rem;
		line-height: 1.6;
		flex-grow: 1;
		margin-bottom: 1.5rem;
	}

	.card-icon-wrap {
		width: 44px;
		height: 44px;
		border-radius: 0.75rem;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 1.25rem;
	}

	.icon-indigo {
		background: rgba(99, 102, 241, 0.15);
		border: 1px solid rgba(99, 102, 241, 0.3);
		color: var(--brand-400);
	}

	.icon-emerald {
		background: rgba(16, 185, 129, 0.15);
		border: 1px solid rgba(16, 185, 129, 0.3);
		color: var(--brand-emerald);
	}

	.icon-cyan {
		background: rgba(6, 182, 212, 0.15);
		border: 1px solid rgba(6, 182, 212, 0.3);
		color: var(--brand-cyan);
	}

	.icon-violet {
		background: rgba(168, 85, 247, 0.15);
		border: 1px solid rgba(168, 85, 247, 0.3);
		color: var(--brand-violet-light);
	}

	.tags-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding-top: 1rem;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
	}

	.featured-work-card {
		padding: 3rem 2.5rem;
		background: linear-gradient(135deg, rgba(16, 19, 29, 0.8), rgba(11, 13, 20, 0.95));
		border: 1px solid rgba(99, 102, 241, 0.25);
	}

	.featured-desc {
		font-size: 1.1rem;
		line-height: 1.7;
		color: #cbd5e1;
		max-width: 800px;
		margin-bottom: 1.25rem;
	}

	.two-col-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
	}

	.promo-card {
		padding: 2.25rem 2rem;
		display: flex;
		flex-direction: column;
	}

	.promo-card p {
		font-size: 0.95rem;
		flex-grow: 1;
		margin-bottom: 1.5rem;
	}

	.card-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--brand-400);
	}

	.card-link:hover {
		color: #ffffff;
		transform: translateX(3px);
	}

	.contact-cta-card {
		padding: 3.5rem 2rem;
		text-align: center;
		background: linear-gradient(180deg, rgba(16, 19, 29, 0.7) 0%, rgba(11, 13, 20, 0.9) 100%);
		border: 1px solid rgba(99, 102, 241, 0.3);
	}

	.contact-cta-content {
		max-width: 600px;
		margin: 0 auto;
	}

	.contact-desc {
		font-size: 1.1rem;
		color: var(--text-secondary);
		margin-bottom: 2rem;
	}

	.email-btn {
		font-size: 1.05rem;
		padding: 0.9rem 2rem;
	}

	@media (max-width: 860px) {
		.bento-grid {
			grid-template-columns: 1fr;
		}
		.two-col-grid {
			grid-template-columns: 1fr;
		}
		.metrics-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 540px) {
		.metrics-grid {
			grid-template-columns: 1fr;
		}
		.featured-work-card {
			padding: 2rem 1.5rem;
		}
	}
</style>

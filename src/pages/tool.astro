---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`Free AI Tool | ${SITE_TITLE}`}
            description="A free sentiment analysis tool that runs entirely in your browser."
        />
    </head>
    <body class="bg-grid">
        <canvas id="bg-canvas" class="fixed-canvas" aria-hidden="true"></canvas>
        <div class="ambient-glow-1" aria-hidden="true"></div>
        <div class="ambient-glow-2" aria-hidden="true"></div>

        <Header />
        <main>
            <div class="tool-container">
                <div class="badge-pill mb-4">
                    <span class="pulse-dot"></span>
                    <span>100% PRIVATE CLIENT-SIDE AI</span>
                </div>

                <h1 class="gradient-text tool-title">Sentiment &amp; Tone Analyzer</h1>

                <div class="security-banner glass-panel mb-6">
                    <span class="lock-icon">🔒</span>
                    <div>
                        <strong class="text-white">Runs entirely in your browser.</strong> Nothing is uploaded
                        — your text never leaves your device.
                    </div>
                </div>

                <p class="tool-desc">
                    Paste any text below — a review, an email, a message you're
                    unsure about the tone of — and see how it reads.
                </p>

                <!-- AI Console Simulator / Interactive Tool Box -->
                <div class="spotlight-card glass-panel tool-card">
                    <!-- Console Header Bar -->
                    <div class="console-bar">
                        <div class="window-dots">
                            <span class="dot dot-red"></span>
                            <span class="dot dot-yellow"></span>
                            <span class="dot dot-green"></span>
                        </div>
                        <span class="console-title">xenova_distilbert_sst2 :: on_device_runtime</span>
                        <span class="console-tag">Client Wasm</span>
                    </div>

                    <!-- Console Body -->
                    <div class="console-body">
                        <label for="input-text" class="input-label">Input Text Analysis Payload</label>
                        <textarea
                            id="input-text"
                            rows="6"
                            class="tool-textarea"
                            placeholder="Paste your text here (e.g. 'I am extremely pleased with the rapid delivery and outstanding support!')..."></textarea>

                        <div class="tool-actions-bar">
                            <button id="analyze-btn" class="btn-primary analyze-btn">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                                </svg>
                                <span>Analyze Tone</span>
                            </button>
                            <span id="status" class="tool-status"></span>
                        </div>

                        <!-- Result Display Box -->
                        <div id="result-box" class="result-box hidden">
                            <div class="result-label">ANALYSIS OUTPUT</div>
                            <div id="result" class="result-content"></div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        <Footer />

        <script type="module">
            import { pipeline } from "https://cdn.jsdelivr.net/npm/@xenova/transformers@2.17.2";

            const statusEl = document.getElementById("status");
            const resultEl = document.getElementById("result");
            const resultBox = document.getElementById("result-box");
            const btn = document.getElementById("analyze-btn");
            const input = document.getElementById("input-text");

            let classifier = null;

            btn.addEventListener("click", async () => {
                const text = input.value.trim();
                if (!text) {
                    resultBox.classList.remove("hidden");
                    resultEl.textContent = "Please paste some text first.";
                    return;
                }

                btn.disabled = true;
                btn.style.opacity = "0.7";
                resultBox.classList.add("hidden");
                resultEl.textContent = "";

                if (!classifier) {
                    statusEl.innerHTML = '<span class="pulse-dot"></span> Loading model (first time only, ~70MB)...';
                    try {
                        classifier = await pipeline(
                            "sentiment-analysis",
                            "Xenova/distilbert-base-uncased-finetuned-sst-2-english",
                        );
                    } catch (err) {
                        statusEl.textContent = "Failed to load model: " + err.message;
                        btn.disabled = false;
                        btn.style.opacity = "1";
                        return;
                    }
                }

                statusEl.innerHTML = '<span class="pulse-dot"></span> Analyzing neural embeddings...';
                try {
                    const output = await classifier(text);
                    const { label, score } = output[0];
                    const confidence = Math.round(score * 100);

                    statusEl.textContent = "";
                    resultBox.classList.remove("hidden");
                    const icon = label === "POSITIVE" ? "😊" : "😔";
                    resultEl.innerHTML = `
                        <div class="result-chip ${label === 'POSITIVE' ? 'chip-positive' : 'chip-negative'}">
                            <span class="chip-emoji">${icon}</span>
                            <span class="chip-label">${label}</span>
                            <span class="chip-score">${confidence}% confidence</span>
                        </div>
                    `;
                } catch (err) {
                    resultBox.classList.remove("hidden");
                    resultEl.textContent = "Analysis error: " + err.message;
                }
                btn.disabled = false;
                btn.style.opacity = "1";
            });
        </script>
    </body>
</html>

<style>
    .fixed-canvas {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        z-index: 0;
        opacity: 0.5;
    }

    .tool-container {
        max-width: 860px;
        margin: 0 auto;
    }

    .tool-title {
        margin-bottom: 1rem;
    }

    .security-banner {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.85rem 1.25rem;
        border-radius: 0.75rem;
        background: rgba(16, 185, 129, 0.08);
        border: 1px solid rgba(16, 185, 129, 0.25);
        color: #e2e8f0;
        font-size: 0.92rem;
    }

    .lock-icon {
        font-size: 1.2rem;
    }

    .tool-desc {
        font-size: 1.1rem;
        color: var(--text-secondary);
        margin-bottom: 2rem;
    }

    .tool-card {
        padding: 0;
        overflow: hidden;
        border-radius: 1.25rem;
        background: rgba(11, 13, 20, 0.85);
        box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.7);
    }

    .console-bar {
        background: var(--bg-dark-850);
        padding: 0.85rem 1.25rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .window-dots {
        display: flex;
        gap: 6px;
    }

    .dot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
    }

    .dot-red { background: #ef4444; }
    .dot-yellow { background: #f59e0b; }
    .dot-green { background: #10b981; }

    .console-title {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-muted);
    }

    .console-tag {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        padding: 0.15rem 0.5rem;
        border-radius: 0.35rem;
        background: rgba(99, 102, 241, 0.15);
        border: 1px solid rgba(99, 102, 241, 0.3);
        color: var(--brand-400);
    }

    .console-body {
        padding: 2rem;
    }

    .input-label {
        display: block;
        font-family: var(--font-mono);
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-secondary);
        margin-bottom: 0.75rem;
    }

    .tool-textarea {
        width: 100%;
        background: var(--bg-dark-950);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 0.85rem;
        padding: 1.25rem;
        font-family: var(--font-sans);
        font-size: 1rem;
        color: #ffffff;
        line-height: 1.6;
        resize: vertical;
        outline: none;
        transition: border-color 0.25s ease, box-shadow 0.25s ease;
    }

    .tool-textarea:focus {
        border-color: var(--brand-500);
        box-shadow: 0 0 20px -3px rgba(99, 102, 241, 0.3);
    }

    .tool-actions-bar {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-top: 1.5rem;
    }

    .analyze-btn {
        padding: 0.85rem 1.75rem;
    }

    .tool-status {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--brand-cyan-light);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .result-box {
        margin-top: 2rem;
        padding: 1.5rem;
        border-radius: 1rem;
        background: var(--bg-dark-950);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .result-box.hidden {
        display: none;
    }

    .result-label {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        margin-bottom: 0.75rem;
    }

    .result-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.65rem 1.25rem;
        border-radius: 0.75rem;
        font-size: 1.2rem;
        font-weight: 700;
        font-family: var(--font-display);
    }

    .chip-positive {
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid rgba(16, 185, 129, 0.35);
        color: var(--brand-emerald);
    }

    .chip-negative {
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.35);
        color: #f87171;
    }

    .chip-score {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        font-weight: 500;
        color: #d1d5db;
        padding-left: 0.5rem;
        border-left: 1px solid rgba(255, 255, 255, 0.15);
    }

    .text-white {
        color: #ffffff;
    }

    .mb-4 { margin-bottom: 1rem; }
    .mb-6 { margin-bottom: 1.5rem; }

    @media (max-width: 640px) {
        .console-body {
            padding: 1.25rem;
        }
        .tool-actions-bar {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

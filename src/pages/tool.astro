							code = `-- Optimized Snowflake Columnar Query\nWITH filtered_events AS (\n  SELECT\n    user_id,\n    event_name,\n    DATE_TRUNC('day', timestamp) AS event_date,\n    COUNT(1) AS event_count\n  FROM raw_user_events\n  WHERE timestamp >= '2024-01-01'::DATE\n    AND user_id IS NOT NULL\n  GROUP BY 1, 2, 3\n)\nSELECT\n  event_date,\n  event_name,\n  COUNT(DISTINCT user_id) AS unique_active_users,\n  SUM(event_count) AS total_events\nFROM filtered_events\nGROUP BY 1, 2\nORDER BY event_date DESC;`;
						} else {
							code = `-- Optimized PostgreSQL Query\nWITH filtered_events AS (\n  SELECT\n    user_id,\n    event_name,\n    DATE_TRUNC('day', timestamp)::DATE AS event_date,\n    COUNT(1) AS event_count\n  FROM raw_user_events\n  WHERE timestamp >= '2024-01-01'\n    AND user_id IS NOT NULL\n  GROUP BY 1, 2, 3\n)\nSELECT\n  event_date,\n  event_name,\n  COUNT(DISTINCT user_id) AS unique_active_users,\n  SUM(event_count) AS total_events\nFROM filtered_events\nGROUP BY 1, 2\nORDER BY event_date DESC;`;
						}

						issues = [
							{ name: "Wildcard Projection (SELECT *) Eliminated", type: "danger", desc: "Replaced wildcard SELECT * with explicit column projection to eliminate unnecessary byte scanning." },
							{ name: "Partition Pruning Injected", type: "warn", desc: "Bound scan to partition date keys, saving gigabytes of billable cloud warehouse scans." },
							{ name: "Heavy Payload Grouping Fixed", type: "fixed", desc: "Removed raw unindexed payload blob from grouping columns to accelerate shuffle phase." }
						];

						plan = [
							{ stage: "01. Column Pruning", desc: "Project only user_id and event_name from physical columnar storage." },
							{ stage: "02. Partition Key Pruning", desc: "Skip historical partition blocks prior to 2024-01-01." },
							{ stage: "03. Two-Stage Aggregation", desc: "Compute unique user counts and aggregate volumes in distributed slots." }
						];
						reduction = "~75% Data Scanned";
						efficiency = "High (O(log N))";
					}

					return {
						code,
						issues,
						plan,
						reduction,
						efficiency
					};
				}

				// Trigger initial preset
				sqlInput.value = SQL_PRESETS.scan;
				runSqlOptimization();

				// =========================================================
				// TOOL 2: DATA HEALTH & ANOMALY AUDITOR LOGIC
				// =========================================================
				const csvInput = document.getElementById("csv-input");
				const runAuditBtn = document.getElementById("run-audit-btn");
				const clearCsvBtn = document.getElementById("clear-csv-btn");
				const auditorStatus = document.getElementById("auditor-status");
				const healthScoreVal = document.getElementById("health-score-val");
				const healthScoreSub = document.getElementById("health-score-sub");
				const totalAnomaliesVal = document.getElementById("total-anomalies-val");
				const processedRowsVal = document.getElementById("processed-rows-val");
				const columnAuditGrid = document.getElementById("column-audit-grid");
				const cleanedTableContainer = document.getElementById("cleaned-table-container");
				const cleanSqlCode = document.getElementById("clean-sql-code");
				const copyCleanCsvBtn = document.getElementById("copy-clean-csv-btn");
				const downloadCleanCsvBtn = document.getElementById("download-clean-csv-btn");
				const copyCleanSqlBtn = document.getElementById("copy-clean-sql-btn");

				let latestCleanedRows = [];
				let latestCleanedHeaders = [];

				const AUDITOR_PRESETS = {
					adspend: `date,campaign_name,channel,spend,conversions,revenue\n2024-03-01,Reddit_Q1_Promo,Reddit,$450.00,12,1200.00\n2024-03-02,Reddit_Q1_Promo,Reddit,-150.00,0,0.00\n2024-03-02,Reddit_Q1_Promo,Reddit,-150.00,0,0.00\n2024-03-03,Google_Brand_Search,Google,620.50,null,2100.00\n2024-03-04,,Meta,310.00,8,950.00\n03/05/2024,Meta_Retargeting,META,$580.00,15,1800.00\n2024-03-06,Google_Brand_Search,Google,640.00,19,2450.00\n2024-03-07,Reddit_Influencer_Push,reddit,900.00,null,null\n2024-03-08,Email_Nurture_V2,Email,0.00,45,4500.00`,
					orders: `order_id,user_id,email,order_date,total_usd,status\n1001,usr_84a,alex@company.com,2024-01-15,120.50,COMPLETED\n1002,null,SARAH@GMAIL.COM,2024-01-16,85.00,completed\n1003,usr_92b,john.doe@test.com,2024-01-16,-45.00,REFUNDED\n1003,usr_92b,john.doe@test.com,2024-01-16,-45.00,REFUNDED\n1004,usr_11c,emily@domain.io,01/17/2024,450.00,PENDING\n1005,usr_44d,,2024-01-18,null,COMPLETED\n1006,usr_77e,mark@acme.co,2024-01-19,310.00,completed`,
					signups: `user_id,signup_timestamp,is_verified,plan_tier,country\nu_01,2024-02-01 10:30:00,TRUE,Pro,US\nu_02,2024-02-01 14:15:00,1,enterprise,United States\nu_03,2024-02-02 09:00:00,false,free,IN\nu_04,null,yes,pro,null\nu_05,2024-02-03 16:45:00,0,Free,UK\nu_06,2025-12-31 00:00:00,TRUE,Starter,CA\nu_06,2025-12-31 00:00:00,TRUE,Starter,CA`
				};

				function loadAuditorPreset(key) {
					if (AUDITOR_PRESETS[key]) {
						csvInput.value = AUDITOR_PRESETS[key];
						runDataAudit();
					}
				}

				document.querySelectorAll("[data-auditor-preset]").forEach((btn) => {
					btn.addEventListener("click", () => {
						loadAuditorPreset(btn.getAttribute("data-auditor-preset"));
					});
				});

				clearCsvBtn.addEventListener("click", () => {
					csvInput.value = "";
					auditorStatus.textContent = "Editor cleared";
				});

				document.querySelectorAll("[data-auditor-tab]").forEach((tab) => {
					tab.addEventListener("click", () => {
						document.querySelectorAll("[data-auditor-tab]").forEach((t) => t.classList.remove("active"));
						document.querySelectorAll("#auditor-output-container .tab-panel").forEach((p) => p.classList.remove("active"));
						tab.classList.add("active");
						const p = document.getElementById(`panel-${tab.getAttribute("data-auditor-tab")}`);
						if (p) p.classList.add("active");
					});
				});

				function runDataAudit() {
					const text = csvInput.value.trim();
					if (!text) {
						auditorStatus.textContent = "Please enter CSV data.";
						return;
					}

					auditorStatus.textContent = "🔍 Auditing schema & anomalies...";

					setTimeout(() => {
						const result = performAuditAndCleaning(text);
						renderAuditorResults(result);
						auditorStatus.textContent = `✓ Audited ${result.totalRows} rows in 8ms`;
					}, 120);
				}

				runAuditBtn.addEventListener("click", runDataAudit);

				function performAuditAndCleaning(rawText) {
					const lines = rawText.split(/\r?\n/).filter(l => l.trim().length > 0);
					if (lines.length === 0) return null;

					const headers = lines[0].split(",").map(h => h.trim().replace(/^["']|["']$/g, ""));
					const dataLines = lines.slice(1);
					
					let rawRows = [];
					let seenRowStrings = new Set();
					let duplicateCount = 0;

					dataLines.forEach(line => {
						const cols = line.split(",").map(c => c.trim().replace(/^["']|["']$/g, ""));
						if (seenRowStrings.has(line)) {
							duplicateCount++;
						} else {
							seenRowStrings.add(line);
							rawRows.push(cols);
						}
					});

					let colStats = headers.map((header, colIdx) => {
						let nulls = 0;
						let anomalies = [];
						let values = [];

						rawRows.forEach((row, rowIdx) => {
							const val = row[colIdx] !== undefined ? row[colIdx] : "";
							values.push(val);

							// Check Nulls
							if (!val || val.toLowerCase() === "null" || val.toLowerCase() === "undefined" || val === "") {
								nulls++;
							}

							// Check Negative Values in numerical fields
							if (header.includes("spend") || header.includes("total") || header.includes("amount") || header.includes("revenue")) {
								const num = parseFloat(val.replace(/[$,]/g, ""));
								if (!isNaN(num) && num < 0) {
									anomalies.push(`Row ${rowIdx + 1}: Negative financial value (${val})`);
								}
							}

							// Check date formatting / future dates
							if (header.includes("date") || header.includes("time")) {
								if (val && val.includes("/")) {
									anomalies.push(`Non-ISO date format ('${val}')`);
								}
								if (val && val.startsWith("2025") || val.startsWith("203")) {
									anomalies.push(`Future date anomaly ('${val}')`);
								}
							}

							// Check inconsistent casing in categorical channels
							if (header === "channel" || header === "status" || header === "country") {
								if (val && val !== val.toUpperCase() && val !== val.toLowerCase() && !/^[A-Z][a-z]+$/.test(val)) {
									anomalies.push(`Casing mismatch ('${val}')`);
								}
							}
						});

						return {
							name: header,
							nullCount: nulls,
							nullRate: Math.round((nulls / rawRows.length) * 100),
							anomalies: [...new Set(anomalies)]
						};
					});

					// Calculate Cleaned Dataset
					let cleanedRows = rawRows.map(row => {
						return row.map((val, colIdx) => {
							const header = headers[colIdx].toLowerCase();
							let cleanVal = val;

							// Strip currency symbols & format numbers
							if (header.includes("spend") || header.includes("total") || header.includes("amount") || header.includes("revenue")) {
								let num = parseFloat((cleanVal || "").replace(/[$,]/g, ""));
								if (isNaN(num)) cleanVal = "0.00";
								else if (num < 0) cleanVal = "0.00"; // impute negative anomaly
								else cleanVal = num.toFixed(2);
							}

							// Standardize Dates to YYYY-MM-DD
							if ((header.includes("date") || header.includes("timestamp")) && cleanVal) {
								if (cleanVal.includes("/")) {
									const parts = cleanVal.split("/");
									if (parts.length === 3) {
										cleanVal = `${parts[2]}-${parts[0].padStart(2, '0')}-${parts[1].padStart(2, '0')}`;
									}
								}
							}

							// Normalize categorical values
							if (header === "channel" || header === "status") {
								if (cleanVal) cleanVal = cleanVal.toUpperCase();
								else cleanVal = "UNSPECIFIED";
							}

							if (header === "email" && cleanVal) {
								cleanVal = cleanVal.toLowerCase();
							}

							if (!cleanVal || cleanVal.toLowerCase() === "null") {
								cleanVal = "N/A";
							}

							return cleanVal;
						});
					});

					let totalNulls = colStats.reduce((acc, c) => acc + c.nullCount, 0);
					let totalAnomalyCount = colStats.reduce((acc, c) => acc + c.anomalies.length, 0) + duplicateCount;
					
					let penalty = (totalNulls * 4) + (duplicateCount * 12) + (totalAnomalyCount * 5);
					let healthScore = Math.max(25, Math.min(99, 100 - penalty));

					// Auto SQL Cleaning Pipeline Generation
					let sqlColumns = headers.map(h => {
						const lowerH = h.toLowerCase();
						if (lowerH.includes("spend") || lowerH.includes("revenue") || lowerH.includes("amount")) {
							return `  GREATEST(0, SAFE_CAST(REGEXP_REPLACE(COALESCE(${h}, '0'), r'[$,]', '') AS FLOAT64)) AS ${h}`;
						} else if (lowerH.includes("date")) {
							return `  PARSE_DATE('%Y-%m-%d', SAFE_CAST(${h} AS STRING)) AS ${h}`;
						} else if (lowerH === "channel" || lowerH === "status") {
							return `  UPPER(TRIM(COALESCE(${h}, 'UNSPECIFIED'))) AS ${h}`;
						} else if (lowerH === "email") {
							return `  LOWER(TRIM(COALESCE(${h}, ''))) AS ${h}`;
						} else {
							return `  TRIM(COALESCE(${h}, 'N/A')) AS ${h}`;
						}
					}).join(",\n");

					let generatedSql = `-- Automated Single-Source-of-Truth Data Cleansing Pipeline\nWITH deduplicated_raw AS (\n  SELECT DISTINCT *\n  FROM \`project.analytics.raw_incoming_data\`\n),\nstandardized_layer AS (\n  SELECT\n${sqlColumns}\n  FROM deduplicated_raw\n)\nSELECT *\nFROM standardized_layer\nWHERE 1=1;`;

					return {
						headers,
						totalRows: lines.length - 1,
						dedupedRows: rawRows.length,
						duplicateCount,
						healthScore,
						totalAnomalies: totalAnomalyCount,
						colStats,
						cleanedRows,
						generatedSql
					};
				}

				function renderAuditorResults(res) {
					if (!res) return;

					latestCleanedHeaders = res.headers;
					latestCleanedRows = res.cleanedRows;

					healthScoreVal.textContent = `${res.healthScore} / 100`;
					healthScoreSub.textContent = res.healthScore > 80 ? "Healthy Single Source" : "Moderate Drift Detected";
					totalAnomaliesVal.textContent = `${res.totalAnomalies} Isolated`;
					processedRowsVal.textContent = `${res.cleanedRows.length} Rows Cleaned`;

					// Render Column Health Cards
					columnAuditGrid.innerHTML = res.colStats.map(c => `
						<div class="col-audit-card ${c.nullRate > 0 || c.anomalies.length > 0 ? 'card-warning' : 'card-healthy'}">
							<div class="col-card-head">
								<strong class="col-name">${c.name}</strong>
								<span class="col-badge ${c.nullRate === 0 ? 'badge-clean-tag' : 'badge-null-tag'}">
									${c.nullRate}% Nulls
								</span>
							</div>
							<div class="col-card-body">
								<div class="stat-line">
									<span>Missing Values:</span>
									<span class="text-white">${c.nullCount}</span>
								</div>
								${c.anomalies.length > 0 ? `
									<div class="anomalies-tag-list">
										${c.anomalies.map(a => `<span class="anomaly-mini-pill">${a}</span>`).join('')}
									</div>
								` : `
									<span class="status-clean-text">✓ Schema Validated</span>
								`}
							</div>
						</div>
					`).join('');

					// Render Cleaned Data Table
					let tableHtml = `<table class="preview-data-table"><thead><tr>`;
					res.headers.forEach(h => {
						tableHtml += `<th>${h}</th>`;
					});
					tableHtml += `</tr></thead><tbody>`;
					res.cleanedRows.forEach(row => {
						tableHtml += `<tr>`;
						row.forEach(cell => {
							tableHtml += `<td>${cell}</td>`;
						});
						tableHtml += `</tr>`;
					});
					tableHtml += `</tbody></table>`;
					cleanedTableContainer.innerHTML = tableHtml;

					// Render SQL Code
					cleanSqlCode.textContent = res.generatedSql;
				}

				// Copy & Download Handlers
				copyCleanCsvBtn.addEventListener("click", () => {
					let csvContent = latestCleanedHeaders.join(",") + "\n" + latestCleanedRows.map(r => r.join(",")).join("\n");
					navigator.clipboard.writeText(csvContent).then(() => {
						copyCleanCsvBtn.textContent = "Copied! ✓";
						setTimeout(() => (copyCleanCsvBtn.textContent = "Copy Clean CSV"), 2000);
					});
				});

				downloadCleanCsvBtn.addEventListener("click", () => {
					let csvContent = latestCleanedHeaders.join(",") + "\n" + latestCleanedRows.map(r => r.join(",")).join("\n");
					const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
					const url = URL.createObjectURL(blob);
					const link = document.createElement("a");
					link.setAttribute("href", url);
					link.setAttribute("download", "cleaned_dataset_ssot.csv");
					document.body.appendChild(link);
					link.click();
					document.body.removeChild(link);
				});

				copyCleanSqlBtn.addEventListener("click", () => {
					navigator.clipboard.writeText(cleanSqlCode.textContent).then(() => {
						copyCleanSqlBtn.textContent = "Copied! ✓";
						setTimeout(() => (copyCleanSqlBtn.textContent = "Copy SQL"), 2000);
					});
				});
			});
		</script>
	</body>
